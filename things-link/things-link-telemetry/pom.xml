<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>com.things.link</groupId><artifactId>things-link</artifactId><version>0.0.1-SNAPSHOT</version></parent>
    <artifactId>things-link-telemetry</artifactId>
    <dependencies>
        <dependency><groupId>com.things.link</groupId><artifactId>things-link-shared</artifactId></dependency>
        <dependency><groupId>com.things.link</groupId><artifactId>things-link-support</artifactId></dependency>
        <dependency><groupId>com.things.link</groupId><artifactId>things-link-device</artifactId></dependency>
        <dependency><groupId>com.things.link</groupId><artifactId>things-link-project</artifactId></dependency>
        <!-- S6 只调用告警域公开的 application 评估端口，遥测域绝不直接写 alarm_* 表。 -->
        <dependency><groupId>com.things.link</groupId><artifactId>things-link-alarm</artifactId></dependency>
        <!-- S7-5 命令与时序写指标由 telemetry 自己注册，不能依赖 bootstrap 的 actuator 传递依赖。 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers-postgresql</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers-junit-jupiter</artifactId><scope>test</scope></dependency>
    </dependencies>
</project>
