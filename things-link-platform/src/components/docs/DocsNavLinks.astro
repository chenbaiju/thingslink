---
/** 文档集合的同一份分组目录用于桌面和移动端。 */
import { docsPath, isCurrentPath } from '@/config'

export interface Props {
  docs: Array<{ id: string; data: { title: string; group: string } }>
  currentPath: string
}

const { docs, currentPath } = Astro.props
const groups = [...new Set(docs.map((doc) => doc.data.group))]
---

<div class="docs-nav-groups">
  {groups.map((group) => (
    <section class="docs-nav-group" aria-label={group}>
      <h3 class="docs-nav-group-title">{group}</h3>
      <ul class="docs-nav-list">
        {docs.filter((doc) => doc.data.group === group).map((doc) => {
          const href = docsPath(doc.id)
          return (
            <li>
              <a href={href} aria-current={isCurrentPath(currentPath, href) ? 'page' : undefined}
                class="docs-nav-link">{doc.data.title}</a>
            </li>
          )
        })}
      </ul>
    </section>
  ))}
</div>
