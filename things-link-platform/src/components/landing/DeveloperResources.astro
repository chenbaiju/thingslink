---
import Button from '@/components/ui/Button.astro'
import { SITE, docsPath } from '@/config'

const resources = [
  { id: 'start', title: '快速开始', description: '了解项目、设备与密钥的准备步骤，以及连接前需要取得的部署参数。', label: '阅读快速开始', href: docsPath('getting-started') },
  { id: 'docs', title: '开发者文档', description: '从文档首页查找已有资料，了解官网指引与控制台操作的分工。', label: '浏览文档首页', href: SITE.docsUrl }
]
---

<section id="developer-resources" class="scroll-mt-header bg-bg-secondary py-section-sm md:py-section" aria-labelledby="developer-resources-title">
  <div class="container-page">
    <h2 id="developer-resources-title" class="text-3xl font-bold text-text-primary md:text-4xl">开发者资源</h2>
    <p class="mt-4 max-w-2xl leading-relaxed text-text-secondary">从接入准备开始，按已有资料了解下一步操作。</p>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {resources.map((resource) => (
        <article class="flex flex-col rounded-xl border border-border bg-white p-6" aria-labelledby={`resource-${resource.id}`}>
          <h3 id={`resource-${resource.id}`} class="text-xl font-semibold text-text-primary">{resource.title}</h3>
          <p class="mt-3 mb-6 leading-relaxed text-text-secondary">{resource.description}</p>
          <div class="mt-auto"><Button href={resource.href} variant="secondary">{resource.label}</Button></div>
        </article>
      ))}
    </div>
  </div>
</section>
