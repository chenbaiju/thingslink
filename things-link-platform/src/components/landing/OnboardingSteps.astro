---
import Button from '@/components/ui/Button.astro'
import { SITE, docsPath } from '@/config'

const steps = [
  { title: '准备项目与设备', detail: '创建或选择项目，再创建设备实例；按需求配置设备类型与物模型。' },
  { title: '保存设备密钥', detail: '在设备凭据入口生成密钥，立即复制并安全保存一次性显示的明文。' },
  { title: '按协议连接', detail: '准备部署方提供的连接参数，使用设备标识和密钥连接 MQTT 并上报属性。' },
  { title: '核对设备数据', detail: '在控制台核对设备上报结果，再继续了解远程控制与规则能力。' }
]
---

<section id="getting-started" class="scroll-mt-header bg-bg-secondary py-section-sm md:py-section" aria-labelledby="onboarding-title">
  <div class="container-page">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold text-brand-700">接入流程</p>
      <h2 id="onboarding-title" class="mt-3 text-3xl font-bold text-text-primary md:text-4xl">从准备设备到核对数据</h2>
      <p class="mt-4 leading-relaxed text-text-secondary">先准备项目、设备和连接参数，再按协议连接并核对上报结果。</p>
    </div>
    <ol class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
      {steps.map((step, index) => (
        <li class="rounded-xl border border-border bg-white p-6">
          <span aria-hidden="true" class="text-sm font-semibold text-brand-700">{String(index + 1).padStart(2, '0')}</span>
          <h3 class="mt-4 text-lg font-semibold text-text-primary">{step.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-text-secondary">{step.detail}</p>
        </li>
      ))}
    </ol>
    <p class="mt-6 text-sm leading-relaxed text-text-secondary">连接地址、可用区域与权限以实际部署为准。连接前请取得对应部署的接入参数与协议说明。</p>
    <div class="mt-6">
      {SITE.docsEnabled && (<Button href={docsPath('getting-started')} variant="secondary">阅读快速开始</Button>)}
    </div>
  </div>
</section>
