---
/**
 * Hero 区域。
 *
 * 左右结构：左侧价值主张与 CTA，右侧产品视觉位。
 * 手机上按“标题 → 摘要 → 按钮 → 视觉”的自然顺序排列（DOM 顺序即阅读顺序）。
 *
 * 右侧使用本地 Console 项目概况截图，侧栏分组保持收起。
 * 截图内使用统计为模拟数据，来源与验证记录见官网能力证据 T05-C。
 */
import { SITE } from '@/config'
import Button from '@/components/ui/Button.astro'
import Icon from '@/components/ui/Icon.astro'
---

<section class="relative overflow-hidden">
  <!-- 背景渐变 -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-50 via-white to-brand-100/40"></div>
    <!-- 固定纵向锚点避免流式解析撑高Hero时，热缓存下的光斑发生布局位移。 -->
    <div class="absolute top-[-120px] right-[-10%] w-[600px] h-[600px] rounded-full bg-brand-100/40 blur-3xl"></div>
    <div class="absolute top-[440px] left-[-5%] w-[400px] h-[400px] rounded-full bg-brand-50/60 blur-3xl"></div>
  </div>

  <div class="container-page py-20 md:py-28 lg:py-32">
    <div class="grid grid-cols-1 lg:grid-cols-2 items-center gap-12 lg:gap-16">
      <!-- 左列：文案与 CTA -->
      <div class="text-left">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-text-primary leading-tight tracking-tight">
          物联网云平台
          <span class="block mt-2 bg-gradient-to-r from-brand-600 to-brand-500 bg-clip-text text-transparent">
            让设备连接更简单
          </span>
        </h1>

        <p class="mt-6 text-lg md:text-xl text-text-secondary leading-relaxed max-w-2xl">
          {SITE.description}
        </p>

        <div class="mt-10 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
          {SITE.consoleUrl ? <Button href={SITE.consoleUrl} variant="primary" size="md">
            进入控制台
            <Icon name="arrow-right" size="md" />
          </Button> : <span class="inline-flex items-center rounded-lg border border-border px-5 py-3 text-sm font-medium text-text-muted" aria-disabled="true">控制台暂未开放</span>}

          <Button href={SITE.docsUrl} variant="secondary" size="md">
            <Icon name="book" size="md" />
            查看文档
          </Button>
        </div>
      </div>

      <!-- 右列：真实 Console 项目概况截图 -->
      <div class="w-full">
        <img
          src="/images/console-project-overview.jpg"
          alt="ThingsLink 项目概况：设备数量、在线率、告警分布及模拟使用统计，侧栏菜单收起"
          width="1176"
          height="873"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="block w-full h-auto rounded-2xl border border-border bg-bg-secondary shadow-card"
        />
      </div>
    </div>
  </div>
</section>
