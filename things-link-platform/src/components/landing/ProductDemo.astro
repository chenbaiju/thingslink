---
import Button from '@/components/ui/Button.astro'
import Icon from '@/components/ui/Icon.astro'
import type { IconName } from '@/components/ui/icons'
import { SITE } from '@/config'

interface Demo {
  id: string
  label: string
  icon: IconName
  title: string
  description: string
  steps: Array<{ title: string; detail: string }>
}

// 功能关系示意：不模拟真实控制台页面、运行数据或可执行操作。
const demos: Demo[] = [
  {
    id: 'connections', label: '设备连接', icon: 'plug',
    title: '把设备连接到应用所需的数据',
    description: '通过 MQTT 直连设备，也可经网关接入子设备与 Modbus 设备，集中管理设备连接。',
    steps: [
      { title: '设备与网关', detail: 'MQTT 设备、网关与子设备' },
      { title: '平台接入', detail: '设备凭据与双向消息通道' },
      { title: '设备管理', detail: '设备生命周期与分组' }
    ]
  },
  {
    id: 'telemetry', label: '数据查看', icon: 'chart',
    title: '从设备上报到状态与历史变化',
    description: '集中查看设备当前值，按时间范围查询历史数据，通过聚合结果了解变化。',
    steps: [
      { title: '设备上报', detail: '设备采集的数据' },
      { title: '数据存储', detail: '当前值与历史记录' },
      { title: '查询与查看', detail: '时间范围查询与聚合' }
    ]
  },
  {
    id: 'rules', label: '规则告警', icon: 'bolt',
    title: '让设备消息关联业务动作',
    description: '配置消息规则与脚本处理，将设备消息关联告警、通知或设备动作。通知渠道包括邮件与 Webhook。',
    steps: [
      { title: '设备消息', detail: '进入消息处理流程' },
      { title: '规则处理', detail: '消息规则与脚本' },
      { title: '业务动作', detail: '告警、通知或设备动作' }
    ]
  }
]
---

<section id="product-demo" class="scroll-mt-header py-section-sm md:py-section" aria-labelledby="product-demo-title">
  <div class="container-page">
    <div class="mb-8 max-w-2xl">
      <p class="text-sm font-semibold text-brand-700">产品演示 · 功能示意</p>
      <h2 id="product-demo-title" class="mt-3 text-3xl font-bold text-text-primary md:text-4xl">看懂设备数据如何流转</h2>
      <p class="mt-4 text-text-secondary leading-relaxed">以下展示功能关系，非真实控制台截图，不包含实时设备数据。</p>
    </div>

    <product-demo>
      <!-- 无脚本时是普通锚点导航，所有图示均在下方可读。 -->
      <nav class="demo-tabs mb-6 flex flex-wrap gap-2" aria-label="功能示意视图">
        {demos.map((demo) => (
          <a id={`demo-tab-${demo.id}`} href={`#demo-panel-${demo.id}`} class="demo-tab inline-flex items-center gap-2 rounded-lg border border-border px-4 py-3 text-sm font-semibold text-text-secondary hover:bg-brand-50">
            <Icon name={demo.icon} size="sm" />{demo.label}
          </a>
        ))}
      </nav>
      <div class="space-y-6 demo-panels">
        {demos.map((demo) => (
          <article id={`demo-panel-${demo.id}`} class="demo-panel scroll-mt-header rounded-2xl border border-border bg-bg-secondary p-6 md:p-10" aria-labelledby={`demo-heading-${demo.id}`}>
            <div class="flex items-center gap-2 text-sm font-medium text-brand-700">
              <Icon name={demo.icon} />{demo.label}示意
            </div>
            <h3 id={`demo-heading-${demo.id}`} class="mt-3 text-xl font-semibold text-text-primary md:text-2xl">{demo.title}</h3>
            <p class="mt-3 max-w-3xl text-text-secondary leading-relaxed">{demo.description}</p>
            <figure class="mt-8">
              <ol class="grid gap-4 md:grid-cols-3">
                {demo.steps.map((step, index) => (
                  <li class="relative rounded-xl border border-border bg-white p-5">
                    <span class="text-sm font-semibold text-brand-700">{String(index + 1).padStart(2, '0')}</span>
                    <p class="mt-3 font-semibold text-text-primary">{step.title}</p>
                    <p class="mt-2 text-sm leading-relaxed text-text-secondary">{step.detail}</p>
                  </li>
                ))}
              </ol>
              <figcaption class="mt-4 text-sm text-text-secondary">功能关系示意，不代表控制台页面布局。</figcaption>
            </figure>
          </article>
        ))}
      </div>
    </product-demo>

    <div class="mt-8">
      <Button href={SITE.docsUrl} variant="secondary">浏览开发者文档<Icon name="arrow-right" size="sm" /></Button>
    </div>
  </div>
</section>

<style>
  product-demo { display: block; }
  .demo-tab[aria-selected='true'] {
    background: var(--color-brand-50);
    border-color: var(--color-brand-500);
    color: var(--color-brand-700);
  }
  product-demo[data-enhanced] .demo-panel { min-height: 32rem; margin-block: 0; }
  .demo-panel[hidden] { display: none; }
  @media (min-width: 48rem) {
    product-demo[data-enhanced] .demo-panel { min-height: 27rem; }
  }
</style>

<script>
  class ProductDemo extends HTMLElement {
    connectedCallback() {
      if (this.hasAttribute('data-enhanced')) return
      const tabs = [...this.querySelectorAll<HTMLAnchorElement>('.demo-tab')]
      const panels = [...this.querySelectorAll<HTMLElement>('.demo-panel')]
      const nav = this.querySelector('nav')
      // 结构不完整则保留原生锚点与全部内容，不进行半套初始化。
      if (!nav || !tabs.length || tabs.length !== panels.length || tabs.some((tab, i) => tab.hash !== `#${panels[i].id}`)) return
      const select = (index: number, focus = false) => {
        tabs.forEach((tab, i) => {
          tab.setAttribute('aria-selected', String(i === index))
          tab.tabIndex = i === index ? 0 : -1
          panels[i].hidden = i !== index
        })
        if (focus) tabs[index].focus()
      }
      tabs.forEach((tab, index) => {
        tab.setAttribute('role', 'tab')
        tab.setAttribute('aria-controls', panels[index].id)
        panels[index].setAttribute('role', 'tabpanel')
        panels[index].setAttribute('aria-labelledby', tab.id)
        panels[index].tabIndex = 0
        tab.addEventListener('click', (event) => { event.preventDefault(); select(index) })
        tab.addEventListener('keydown', (event) => {
          let target = index
          if (event.key === 'ArrowRight') target = (index + 1) % tabs.length
          else if (event.key === 'ArrowLeft') target = (index + tabs.length - 1) % tabs.length
          else if (event.key === 'Home') target = 0
          else if (event.key === 'End') target = tabs.length - 1
          else if (event.key !== ' ') return
          event.preventDefault()
          select(target, true)
        })
      })
      nav.setAttribute('role', 'tablist')
      this.setAttribute('data-enhanced', '')
      const initial = panels.findIndex((panel) => `#${panel.id}` === location.hash)
      select(initial < 0 ? 0 : initial)
    }
  }
  if (!customElements.get('product-demo')) customElements.define('product-demo', ProductDemo)
</script>
