---
/**
 * 全局页脚。
 */
import { FOOTER, SITE } from '@/config'
const groupGrid = FOOTER.groups.length > 2 ? 'grid-cols-2 sm:grid-cols-3' : 'grid-cols-2 sm:grid-cols-2'
---

<footer class="border-t border-border mt-auto">
  <div class="container-wide py-12">
    <div class="grid gap-10 lg:grid-cols-[1fr_2fr]">
      <!-- 左侧 Logo + 描述 -->
      <div class="flex flex-col items-start gap-2">
        <a href="/" class="flex items-center gap-2 font-bold text-lg text-text-primary">
          <span class="w-7 h-7 rounded-lg flex items-center justify-center text-white text-xs font-bold bg-brand-gradient-logo">
            TC
          </span>
          <span>{SITE.name}</span>
        </a>
        <p class="text-sm text-text-muted max-w-xs">
          {SITE.description}
        </p>
      </div>

      <!-- 右侧链接 -->
      <div class:list={['grid gap-8', groupGrid]}>
        {FOOTER.groups.map(group => (
          <nav aria-label={`页脚：${group.title}`}>
            <h2 class="text-sm font-semibold text-text-primary">{group.title}</h2>
            <ul class="mt-3 space-y-1">
              {group.links.map(item => (
                <li>
                  <a href={item.href}
                    target={item.external ? '_blank' : undefined}
                    rel={item.external ? 'noopener noreferrer' : undefined}
                    class="inline-flex py-2 text-sm text-text-secondary hover:text-brand-600 transition-colors">
                    {item.label}
                    {item.external && <span class="sr-only">（新窗口打开）</span>}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))}
      </div>
    </div>

    <!-- 底部版权 -->
    <div class="mt-8 pt-6 border-t border-border-light text-center">
      <p class="text-xs text-text-muted">{FOOTER.copyright}</p>
    </div>
  </div>
</footer>
