# www.chenbaiju.com origin static site.
# Keep the certificate and key root-owned with restrictive permissions.
server {
    listen 80;
    server_name www.chenbaiju.com;

    return 308 https://www.chenbaiju.com$request_uri;
}

server {
    listen 443 ssl http2;
    server_name www.chenbaiju.com;

    root /srv/things-link-platform/current;
    index index.html;

    ssl_certificate /etc/nginx/tls/www.chenbaiju.com.pem;
    ssl_certificate_key /etc/nginx/tls/www.chenbaiju.com.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    gzip on;
    gzip_vary on;
    gzip_types text/css application/javascript application/xml image/svg+xml;

    location ^~ /_astro/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location ~* \.(?:woff2|svg)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=3600, must-revalidate" always;
    }

    location = /robots.txt {
        try_files $uri =404;
        add_header Cache-Control "no-cache" always;
    }

    location = /sitemap.xml {
        try_files $uri =404;
        add_header Cache-Control "no-cache" always;
    }

    location / {
        try_files $uri/index.html $uri $uri.html =404;
        add_header Cache-Control "no-cache" always;
    }

    error_page 404 /404.html;
    location = /404.html {
        internal;
        add_header Cache-Control "no-cache" always;
    }
}
