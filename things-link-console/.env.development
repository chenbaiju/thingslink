# 【开发】环境变量

# 应用部署基础路径
VITE_BASE_URL = /

# API 请求基础路径。开发环境用 / 走下面的 Vite 代理，避免处理跨域
VITE_API_URL = /

# 代理目标地址。
#
# 已切到本地后端（S1 切片 2）。
#
# 单人开发下 Mock 的价值有限：数据是自己编的，编得出来不代表后端做得出来。
# 后端一旦有了对应接口就应当立刻直连（开发手册 2.1）。
#
# 后端启动：cd things-link && ./mvnw -pl things-link-bootstrap spring-boot:run
# 依赖栈：cd deploy && make up
VITE_API_PROXY_URL = http://localhost:8080

# 生产构建时移除 console，开发环境保留
VITE_DROP_CONSOLE = false
