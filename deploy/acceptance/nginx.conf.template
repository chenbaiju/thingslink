# Dedicated acceptance include inside http {}; preserves existing default servers.
server {
    listen 80;
    server_name @HOST@;
    access_log off;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/thingslink-acceptance;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 308 @ORIGIN@$request_uri; }
}
server {
    listen @HTTPS_PORT@ ssl;
    server_name @HOST@;
    ssl_certificate @BASE@/tls/fullchain.pem;
    ssl_certificate_key @BASE@/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_session_cache shared:ThingsLinkAcceptance:1m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;
    access_log off;
    error_log /dev/null crit;
    client_max_body_size 16m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    location ^~ /api/v1/emqx/ { return 404; }
    location ^~ /internal/ { return 404; }
    location ^~ /actuator { return 404; }
    location ^~ /device-access/ { return 404; }
    location /api/ {
        proxy_pass http://172.29.240.1:8080;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_bind 172.29.240.1;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_read_timeout 60s;
        add_header Cache-Control no-store always;
    }
    location /ws/ {
        proxy_pass http://172.29.240.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_bind 172.29.240.1;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_read_timeout 90s;
        proxy_buffering off;
    }
    location = /app {
        proxy_pass http://172.29.240.1:8080;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_bind 172.29.240.1;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_read_timeout 60s;
    }
    location ^~ /app/ {
        proxy_pass http://172.29.240.1:8080;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_bind 172.29.240.1;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_read_timeout 60s;
    }
    location / {
        root @BASE@/console;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control no-store always;
    }
}
server {
    listen 8066 ssl;
    server_name @HOST@;
    ssl_certificate @BASE@/tls/fullchain.pem;
    ssl_certificate_key @BASE@/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_session_tickets off;
    access_log off;
    error_log /dev/null crit;
    client_max_body_size 0;
    location / {
        proxy_pass http://172.29.240.15:9000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_request_buffering off;
        proxy_buffering off;
    }
}
