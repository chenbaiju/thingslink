# 复制为 deploy/.env 后使用：  cp .env.example .env
#
# 这里的值是本地开发默认值，可以直接用。
# .env 已在 .gitignore 中，不会被提交；任何真实密钥都不要写进 .env.example。

# ---- 镜像 tag（固定版本，不用 latest）----
TIMESCALEDB_TAG=pg17.4-ts2.18.2
REDIS_TAG=7.4-alpine
REDPANDA_TAG=v24.3.6
REDPANDA_CONSOLE_TAG=v2.8.2
EMQX_TAG=6.2.3
MINIO_TAG=RELEASE.2025-04-22T22-12-26Z
MINIO_MC_TAG=RELEASE.2025-04-16T18-13-26Z
PGADMIN_TAG=9.2
PROMETHEUS_TAG=v3.2.1
GRAFANA_TAG=11.6.0

# ---- PostgreSQL / TimescaleDB ----
POSTGRES_USER=thingslink
POSTGRES_PASSWORD=thingslink
POSTGRES_DB=thingslink
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PASSWORD=thingslink
REDIS_PORT=6379
REDIS_MAXMEMORY=512mb

# ---- Redpanda（Kafka 协议）----
# 宿主机上的 Spring Boot 用 localhost:19092 作为 bootstrap.servers
REDPANDA_PORT=19092
REDPANDA_CONSOLE_PORT=8088

# ---- EMQX ----
EMQX_MQTT_PORT=1883
EMQX_DASHBOARD_PORT=18083
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=thingslink123
EMQX_COOKIE=thingslink-dev-cookie

# ---- MinIO ----
MINIO_ROOT_USER=thingslink
MINIO_ROOT_PASSWORD=thingslink123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- 管理 UI（profile: tools）----
PGADMIN_EMAIL=dev@thingslink.local
PGADMIN_PASSWORD=thingslink
PGADMIN_PORT=5050

# ---- 可观测（profile: obs）----
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=thingslink
